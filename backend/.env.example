# Calendar, Zmanim, and runtime.
RECORDING_TIME_ZONE=America/New_York
TORAT_TSION_LOCATION=
TORAT_TSION_ZMANIM_JSON=
# Set true ONLY when DATA_DIR points to an attached persistent disk.
TORAT_TSION_DATA_PERSISTENT=false
TORAT_TSION_DATA_DIR=/tmp/torat-tsion-data
PORT=8080
