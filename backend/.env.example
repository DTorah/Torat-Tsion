YOUTUBE_PLAYLIST_ID=

# Admin authentication.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Permanent CMS storage (required to retain changes on free Render instances).
GITHUB_CONTENTS_TOKEN=
GITHUB_CONTENTS_REPOSITORY=DTorah/Torat-Tsion
