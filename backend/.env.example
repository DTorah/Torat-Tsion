# Optional official YouTube Data API source (server-only).
YOUTUBE_API_KEY=
YOUTUBE_BAKHSHI_CHANNEL_ID=
YOUTUBE_BAKHSHI_PLAYLIST_ID=
YOUTUBE_SHABBAT_SHALOM_CHANNEL_ID=
YOUTUBE_SHABBAT_SHALOM_PLAYLIST_ID=

# Legacy aliases accepted for the Rabbi Bakhshi source.
