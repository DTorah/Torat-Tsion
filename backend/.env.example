# Server-only production configuration. Never copy this file into the Expo app.

# Google Drive source and OAuth credentials (server-only).
TORAT_TSION_DRIVE_FOLDER_ID=1JZfz7efCHWW8GbjxQ2LOkU7T0ZUy_c8b
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
